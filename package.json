{
  "name": "canvas-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Add Canvas course modules to a private local library that Claude can browse and search (Chrome extension + MCP server).",
  "scripts": {
    "setup": "node scripts/setup.js",
    "setup:desktop": "node scripts/setup.js --desktop",
    "doctor": "node scripts/setup.js --doctor",
    "server": "node server/ingest-main.js",
    "mcp": "node server/mcp.js",
    "test": "node test/run.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "keywords": [
    "canvas",
    "lms",
    "mcp",
    "claude",
    "model-context-protocol",
    "chrome-extension",
    "students"
  ],
  "engines": {
    "node": ">=20"
  }
}
